# =============================================================================
# BChemXtractWeb .gitignore
# Covers: Python, Node, Java/Maven, Docker, IDE, environment, OS artifacts
# =============================================================================

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
.installed.cfg
MANIFEST
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Testing / Coverage
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Type checking
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# Linting / Formatting
.ruff_cache/

# Package managers (uv.lock is NOT ignored -- committed for reproducibility)
.pdm-python
.pdm-build/
.pixi/
__pypackages__/

# PyPI
.pypirc

# Misc Python
*.sage.py
celerybeat-schedule
celerybeat.pid
cython_debug/

# -----------------------------------------------------------------------------
# Node / Frontend
# -----------------------------------------------------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
*.tsbuildinfo

# -----------------------------------------------------------------------------
# Java / Maven
# -----------------------------------------------------------------------------
target/
*.class
*.jar

# Backend-specific: BChemXtract fat JAR (built from a fresh clone of upstream;
# build_jar.sh stages the clone in backend/.bchemxtract-build/ between runs)
backend/jars/*.jar
backend/.bchemxtract-build/

# -----------------------------------------------------------------------------
# Docker
# -----------------------------------------------------------------------------
.docker/

# -----------------------------------------------------------------------------
# IDE / Editor
# -----------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/

# -----------------------------------------------------------------------------
# Environment / Secrets
# -----------------------------------------------------------------------------
# .env* covers .env, .envrc, and any backup variant (.env__, .env.bak, .env.old)
# operators create when rotating secrets — none of those should ever reach the
# remote. .env.example is the single committed exception (placeholders only).
.env*
!.env.example

# -----------------------------------------------------------------------------
# OS files
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
*.log

# -----------------------------------------------------------------------------
# Cursor / AI editors
# -----------------------------------------------------------------------------
.cursorignore
.cursorindexingignore
# Per-project Claude Code config + CodeGraph knowledge graph — local-only.
.claude/
.codegraph/

# -----------------------------------------------------------------------------
# Scratch ChemDraw files dropped at the backend root for manual testing.
# Scoped to the backend root so committed fixtures under
# backend/tests/fixtures/ are unaffected.
# -----------------------------------------------------------------------------
/backend/*.cdx
/backend/*.cdxml

# -----------------------------------------------------------------------------
# Backend-specific
# -----------------------------------------------------------------------------
backend/.venv/
backend/.pytest_cache/
backend/.ruff_cache/

# -----------------------------------------------------------------------------
# Alembic
# -----------------------------------------------------------------------------
# Alembic versions are tracked; no ignores needed

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
.ipynb_checkpoints/
profile_default/
ipython_config.py
CLAUDE.md
DESIGN.md
DESIGN-LEGACY.md
PRODUCT.md
.planning/
test-results/

# Local-only workflow documents (GSD plans, Superpowers specs/plans).
# These capture in-progress Claude-session reasoning and must never
# reach the public remote — commit only user-facing docs.
docs/superpowers/

# Playwright MCP transient artefacts
.playwright-mcp/
nav-*.png

# Local-only code-review artefacts
REVIEW-BACKEND.md
REVIEW-FRONTEND.md

# Clan Pro webfont files (commercial, user-supplied — see
# frontend/public/fonts/clan-pro/README.md).
frontend/public/fonts/clan-pro/*.woff2
frontend/public/fonts/clan-pro/*.woff
