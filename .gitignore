# =============================================================================
# BChemXtractWeb .gitignore
# Covers: Python, Node, Java/Maven, Docker, IDE, environment, OS artifacts
# =============================================================================

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
.installed.cfg
MANIFEST
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Testing / Coverage
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Type checking
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# Linting / Formatting
.ruff_cache/

# Package managers (uv.lock is NOT ignored -- committed for reproducibility)
.pdm-python
.pdm-build/
.pixi/
__pypackages__/

# PyPI
.pypirc

# Misc Python
*.sage.py
celerybeat-schedule
celerybeat.pid
cython_debug/

# -----------------------------------------------------------------------------
# Node / Frontend
# -----------------------------------------------------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
*.tsbuildinfo

# -----------------------------------------------------------------------------
# Java / Maven
# -----------------------------------------------------------------------------
target/
*.class
*.jar

# Backend-specific: BChemXtract fat JAR (built from submodule)
backend/jars/*.jar

# -----------------------------------------------------------------------------
# Docker
# -----------------------------------------------------------------------------
.docker/

# -----------------------------------------------------------------------------
# IDE / Editor
# -----------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/

# -----------------------------------------------------------------------------
# Environment / Secrets
# -----------------------------------------------------------------------------
.env
.envrc
# Note: .env.example is tracked (contains only placeholder values)

# -----------------------------------------------------------------------------
# OS files
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
*.log

# -----------------------------------------------------------------------------
# Cursor / AI editors
# -----------------------------------------------------------------------------
.cursorignore
.cursorindexingignore

# -----------------------------------------------------------------------------
# Backend-specific
# -----------------------------------------------------------------------------
backend/.venv/
backend/.pytest_cache/
backend/.ruff_cache/

# -----------------------------------------------------------------------------
# Alembic
# -----------------------------------------------------------------------------
# Alembic versions are tracked; no ignores needed

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
.ipynb_checkpoints/
profile_default/
ipython_config.py
CLAUDE.md
DESIGN.md
DESIGN-LEGACY.md
.planning/
test-results/

# Local-only workflow documents (GSD plans, Superpowers specs/plans).
# These capture in-progress Claude-session reasoning and must never
# reach the public remote — commit only user-facing docs.
docs/superpowers/

# Playwright MCP transient artefacts
.playwright-mcp/
nav-*.png

# Runtime secrets — .env.example is committed, .env is not
.env

# Local-only code-review artefacts
REVIEW-BACKEND.md
REVIEW-FRONTEND.md
