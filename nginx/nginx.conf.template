# SEC/OPS: force nginx to re-resolve container IPs on every request
# via Docker's embedded DNS (127.0.0.11). Without this, nginx caches
# the upstream IPs at startup and returns 502 after any frontend or
# backend container rebuild (their Docker-assigned IPs change).
#
# `valid=10s` caps the cache window; `ipv6=off` is required because
# Docker's embedded resolver does not answer AAAA queries and would
# inject ~5s of timeout per request otherwise.
resolver 127.0.0.11 valid=10s ipv6=off;

server {
    listen 80;
    server_name _;

    # Upstream URLs as variables — this (not the literal host:port in
    # proxy_pass) is what triggers runtime DNS re-resolution.
    set $frontend_upstream "http://frontend:80";
    set $backend_upstream  "http://backend:8000";

    # Deployment sub-path absorber.
    #
    # The production Apache vhost proxies
    #   /bchemxtract -> http://localhost:3000/bchemxtract
    # with the prefix PRESERVED. Prefix `location` blocks match from the START
    # of the URI, so /bchemxtract/api/... would NOT match `location /api/` —
    # it would fall into `location /`, be served the SPA's index.html with a
    # 200, and every API call would silently receive HTML instead of JSON.
    # Strip the prefix here so the existing locations match unchanged.
    #
    # Must stay in sync with BASE_PATH in .env, which is what the frontend
    # build bakes into its asset and API URLs. No-op when the prefix is absent,
    # so direct :3000 access, both container healthchecks, and local dev are
    # unaffected. `last` re-runs location matching on the rewritten URI.
    rewrite ^/bchemxtract$      /  last;
    rewrite ^/bchemxtract(/.*)$ $1 last;

    # Frontend SPA (proxied to frontend container)
    location / {
        proxy_pass $frontend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Backend API proxy.
    # NOTE: when proxy_pass uses a variable, nginx does NOT replace
    # the location-matched prefix with the URI portion of the target —
    # it passes the full original request URI unchanged. So we omit
    # the `/api/` suffix here and let the original `/api/...` path
    # flow through verbatim. (With a literal proxy_pass we would
    # write `http://backend:8000/api/`; with a variable we must not.)
    location /api/ {
        proxy_pass $backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Security headers for backend-proxied responses. The SPA's headers
        # live in frontend.conf (the inner container) and do NOT apply here,
        # and nginx does not inherit add_header once a location sets its own,
        # so each backend location re-emits them. CSP is limited to framing /
        # base-uri (not a resource policy) so it never breaks Swagger UI's
        # assets on /docs; JSON/file API responses are not rendered anyway.
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'" always;

        # The backend scopes every /api/* request
        # by the ``bcx_sid`` cookie (browser SPA path) or ``X-API-Key``
        # header (programmatic / admin path). Nginx no longer injects
        # credentials — the request reaches the backend with whatever
        # headers and cookies the client sent. The backend's
        # get_scoped_db dependency issues a Set-Cookie on the first
        # response if no ``bcx_sid`` is present, so first-time visitors
        # get a session transparently.

        # Lift the default 1 MB request-body cap to slightly
        # above the backend's ``max_upload_size`` (50 MB) so the backend
        # owns the authoritative limit and emits the unified
        # ``{detail, code: FILE_TOO_LARGE}`` JSON response rather than
        # nginx's raw HTML 413. Batch uploads (up to 20 files of 50 MB
        # each) are gated per-file inside the backend
        # (app/services/upload_guard.py).
        client_max_body_size 55m;

        # Extraction can take up to 120s for complex files.
        # Set proxy timeout to 130s so the backend 503 arrives
        # before nginx returns its own 504 Gateway Timeout.
        proxy_read_timeout 130s;
        proxy_send_timeout 130s;

        # Batch SSE progress streams stay open for up to 30 minutes.
        # SSE connections send periodic events so they won't idle-timeout.
    }

    # FastAPI OpenAPI docs proxy. Same variable-proxy_pass rule applies:
    # omit the URI suffix, the original request path flows through.
    location /docs {
        proxy_pass $backend_upstream;
        proxy_set_header Host $host;

        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'" always;
    }

    location /openapi.json {
        proxy_pass $backend_upstream;
        proxy_set_header Host $host;

        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'" always;
    }
}
