# =============================================================================
# BChemXtractWeb — deployment environment template
# =============================================================================
#
# Copy this file to `.env` at the repo root and fill in real values before
# running `docker compose up`. `.env` is gitignored. Every value below is
# referenced by `docker-compose.yml`; missing required values fail fast with
# a clear error (the :?message syntax in compose).
#
# Generate secret-grade values with, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# -----------------------------------------------------------------------------


# --- PostgreSQL ---------------------------------------------------------------
# REQUIRED. 32+ random characters recommended. The compose file refuses to
# start without this value.
#
# Phase 11 dual-role posture (D-01 / Plan 11-05):
#   - POSTGRES_USER (default `bchemxtract`) is the bootstrap superuser. Only
#     the `migrate` service connects as this role — it needs DDL privileges
#     to create RLS policies + CREATE ROLE for the runtime app role.
#   - Runtime services (backend / celery-worker / celery-beat) connect as
#     `bchemxtract_app` (NOSUPERUSER NOBYPASSRLS) so RLS policies actually
#     enforce on every query. The 2026_05_16_create_app_role alembic
#     migration creates / alters that role; its password is APP_DB_PASSWORD
#     (declared further down in this file).
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Optional overrides. Defaults: user=bchemxtract, db=bchemxtract.
#POSTGRES_USER=bchemxtract
#POSTGRES_DB=bchemxtract


# --- Backend secrets (Phase 11) -----------------------------------------------
# REQUIRED in production (DEBUG=false). Both MUST be 32+ chars — the Settings
# `_validate_phase11_secrets` validator refuses to start otherwise.
#
# SECRET_KEY: PBKDF2 salt for API-key lookup hashes (Phase 11 D-10) AND HMAC
# key for CSRF tokens (D-19). DO NOT rotate without coordinating a full API-key
# re-issue — rotation invalidates every stored key_hash. `deploy.sh --rotate-keys`
# deliberately leaves this one alone.
#
# ADMIN_SECRET: gate for /api/admin/api-keys endpoints. Constant-time compared
# against the inbound X-Admin-Secret header. Safe to rotate via
# `./deploy.sh --rotate-keys`.
#
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=REPLACE_WITH_A_32_CHAR_RANDOM_TOKEN
ADMIN_SECRET=REPLACE_WITH_A_32_CHAR_RANDOM_TOKEN

# APP_DB_PASSWORD: password for the runtime `bchemxtract_app` Postgres role
# (NOSUPERUSER NOBYPASSRLS). The 2026_05_16_create_app_role migration creates
# / alters this role to use the value below; the backend, celery-worker, and
# celery-beat services then connect as `bchemxtract_app` so RLS policies
# enforce session ownership on every query. The migrate service stays on the
# bootstrap superuser (POSTGRES_USER) because it needs DDL privileges.
#
# Without this, the previous deployment posture (backend connects as the
# bootstrap superuser) silently bypasses RLS even with FORCE ROW LEVEL
# SECURITY enabled — every cookie session could read every other session.
#
# Rotate with: `./deploy.sh --rotate-app-db` (ALTER ROLE in the running DB +
# .env update; requires backend / celery-worker / celery-beat restart).
APP_DB_PASSWORD=REPLACE_WITH_A_32_CHAR_RANDOM_TOKEN

# Optional Phase 11 tunables (defaults shown).
# API_KEY_DEFAULT_EXPIRY_DAYS — default expiry for new admin-minted API keys.
# API_KEY_MAX_EXPIRY_DAYS     — hard cap on per-key expiry; values above clamp.
# AUDIT_LOG_RETENTION_DAYS    — Celery beat prune cutoff (~12 months default).
#API_KEY_DEFAULT_EXPIRY_DAYS=90
#API_KEY_MAX_EXPIRY_DAYS=365
#AUDIT_LOG_RETENTION_DAYS=365


# --- DATABASE_URL (dev / test only) -------------------------------------------
# In compose deployments the backend composes DATABASE_URL from POSTGRES_*
# vars above. Set this only for local dev runs that bypass compose, e.g.
# `uvicorn app.main:app` against a hand-started Postgres.
#DATABASE_URL=postgresql+psycopg://bchemxtract:REPLACE@localhost:5432/bchemxtract


# --- OpenAPI docs surface (optional) ------------------------------------------
# Defaults to DEBUG. Override to `true` in staging if you want /docs /redoc
# visible to API-key-authenticated callers while DEBUG stays false in prod.
#EXPOSE_OPENAPI_DOCS=false


# --- Rate limits (optional, slowapi syntax "<count>/<period>") ----------------
# Defaults shown; tighten or relax for your traffic profile.
#RATE_LIMIT_DEFAULT=120/minute
#RATE_LIMIT_UPLOAD=10/minute
#RATE_LIMIT_BATCH=3/minute
#RATE_LIMIT_SEARCH=30/minute
#RATE_LIMIT_EXPORT=30/minute
#
# For multi-replica deployments, switch from in-memory to shared Redis:
#RATE_LIMIT_STORAGE_URI=redis://redis:6379/2


# --- CORS origins -------------------------------------------------------------
# JSON array. Must include the production frontend origin.
#
# Phase 11 production guard (`_validate_prod_cors`): in DEBUG=false mode the
# backend REFUSES to start if any entry contains `localhost` or `127.0.0.1`,
# because cookies served over plain HTTP cannot carry the `Secure` flag and
# would travel unencrypted. Production deployments behind HTTPS list only
# their real public origin(s); local docker-compose dev sets DEBUG=true (see
# the DEBUG section below) and may then keep the localhost origin.
#
# Default example value matches the Vite dev server. For docker-compose at
# http://localhost:${HTTP_PORT}, set it to that origin instead.
CORS_ORIGINS=["http://localhost:5173"]


# --- Public HTTP port ---------------------------------------------------------
# The host port docker publishes the nginx reverse proxy on. Default 3000.
# Avoid 80 (collides with Apache/system nginx on most Ubuntu/Debian boxes and
# requires root or CAP_NET_BIND_SERVICE). Avoid 443 (HTTPS, needs TLS termination).
# deploy.sh prompts for this on first run; override with --port N or HTTP_PORT=N.
HTTP_PORT=3000

# Backend FastAPI host port. Bound to 127.0.0.1 only — direct API consumers
# (X-API-Key clients, CLI scripts) reach it via http://127.0.0.1:8000.
# Browser traffic goes through nginx on HTTP_PORT. Rarely changed.
BACKEND_PORT=8000


# --- Debug mode ---------------------------------------------------------------
# Keep `false` in real production deployments (HTTPS). When `false`:
#   - SECRET_KEY + ADMIN_SECRET + APP_DB_PASSWORD all REQUIRED ≥32 chars
#     (the `_validate_phase11_secrets` validator refuses to start otherwise)
#   - bcx_sid cookie carries the `Secure` flag (HTTPS-only)
#   - CORS_ORIGINS must NOT contain `localhost` / `127.0.0.1`
#     (the `_validate_prod_cors` validator — see CORS section above)
#   - /docs + /redoc are hidden unless EXPOSE_OPENAPI_DOCS=true
#
# Set `true` for LOCAL plain-HTTP docker-compose testing on
# http://localhost:${HTTP_PORT}. In debug mode the Secure flag is dropped so
# the cookie works over plain HTTP, and the prod-CORS guard is relaxed. The
# secret-length validators stay relaxed too — they may be empty.
DEBUG=false


# --- Java / JPype (optional overrides) ----------------------------------------
#JAVA_HOME=
#JAR_PATH=jars
#JVM_MAX_HEAP=512m
#JPYPE_WORKERS=4
#JVM_OPTS=-XX:+UseG1GC


# --- Upload + timeout limits (optional) ---------------------------------------
#MAX_UPLOAD_SIZE=52428800          # 50 MB in bytes
#REACTION_TIMEOUT_SECS=30.0

